// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Model Categories
model Category {
  id        Int         @id @default(autoincrement())
  name      String      @unique @db.VarChar(100)
  menuItems MenuItem[]  @relation("CategoryMenuItems")

  @@map("categories")
}

// Model Menu Items
model MenuItem {
  id               Int                  @id @default(autoincrement())
  categoryId       Int                  @map("category_id")
  name             String               @db.VarChar(150)
  price            Decimal              @db.Decimal(10, 2)
  stock            Int                  @default(0)
  estimatedTime    String?              @map("estimated_time") @db.VarChar(20)
  status           String               @default("Uncooked") @db.VarChar(50)
  
  // Relations
  category         Category             @relation("CategoryMenuItems", fields: [categoryId], references: [id], onDelete: Restrict)
  inventoryMovements InventoryMovement[] @relation("MenuItemMovements")

  @@map("menu_items")
}

// Model Inventory Movements
model InventoryMovement {
  id             Int       @id @default(autoincrement())
  menuItemId     Int       @map("menu_item_id")
  quantityChange Int       @map("quantity_change")
  movementType   String    @map("movement_type") @db.VarChar(20)
  reason         String?   @db.Text
  createdAt      DateTime  @default(now()) @map("created_at")
  
  // Relations
  menuItem       MenuItem  @relation("MenuItemMovements", fields: [menuItemId], references: [id], onDelete: Cascade)

  @@map("inventory_movements")
}
