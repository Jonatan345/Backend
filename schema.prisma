generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ItemType {
  RAW           // Ingredients (Beef, Buns)
  RETAIL        // Buy & Sell as-is (Soda)
  MANUFACTURED  // Made from recipes (Burger)
}

model Item {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(150)
  type        ItemType
  price       Decimal? @db.Decimal(10, 2) // Nullable because RAW items aren't sold
  stock       Int      @default(0)
  
  // Relations
  orderItems        OrderItem[]
  purchaseItems     PurchaseOrderItem[]
  recipesWhereParent Recipe[] @relation("ParentItem")
  recipesWhereChild  Recipe[] @relation("ChildItem")

  @@map("items")
}

// THE BILL OF MATERIALS (The Missing Link)
// This tells the database how to make a MANUFACTURED item
model Recipe {
  id              Int     @id @default(autoincrement())
  parentItemId    Int     // The Burger
  childItemId     Int     // The Beef Patty
  quantityNeeded  Int     // How many patties per burger?

  parentItem      Item    @relation("ParentItem", fields: [parentItemId], references: [id])
  childItem       Item    @relation("ChildItem", fields: [childItemId], references: [id])

  @@unique([parentItemId, childItemId])
  @@map("recipes")
}

// SELLING (Money In)
model Order {
  id          Int         @id @default(autoincrement())
  totalAmount Decimal     @db.Decimal(10, 2)
  status      String      @default("Pending") // Uncooked, Served, etc. goes HERE
  createdAt   DateTime    @default(now())
  
  items       OrderItem[]

  @@map("orders")
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  itemId    Int     // Must be RETAIL or MANUFACTURED
  quantity  Int
  price     Decimal @db.Decimal(10, 2) // Locked price at time of sale

  order     Order   @relation(fields: [orderId], references: [id])
  item      Item    @relation(fields: [itemId], references: [id])

  @@map("order_items")
}

// BUYING (Money Out & Inventory In)
model PurchaseOrder {
  id          Int                 @id @default(autoincrement())
  supplierId  Int
  createdAt   DateTime            @default(now())
  
  items       PurchaseOrderItem[]

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               Int           @id @default(autoincrement())
  purchaseOrderId  Int
  itemId           Int           // Must be RAW or RETAIL
  quantity         Int
  cost             Decimal       @db.Decimal(10, 2)

  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  item             Item          @relation(fields: [itemId], references: [id])

  @@map("purchase_order_items")
}
